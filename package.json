{
  "name": "harness-deck-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @harness-deck/webview-ui run build && pnpm --filter harness-deck run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:changed": "node scripts/check-changed.mjs",
    "eval": "tsx evals/run.mjs",
    "eval:check": "node evals/grade-check.mjs",
    "perf:check": "tsx scripts/perf-baseline.ts",
    "headless:spike": "tsx scripts/headless-spike.ts",
    "smoke": "pnpm --filter harness-deck run smoke",
    "package": "pnpm run build && pnpm --filter harness-deck run package",
    "dev": "pnpm --parallel --filter @harness-deck/webview-ui --filter harness-deck run watch",
    "preview:web": "pnpm --filter @harness-deck/webview-ui run dev"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
