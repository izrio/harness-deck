{
  "name": "harness-deck",
  "displayName": "Halo",
  "description": "%extension.description%",
  "version": "0.15.0",
  "publisher": "izrio",
  "icon": "media/icon.png",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/izrio/dsh-vscode-copilot.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrusted%"
    }
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "harnessDeck",
          "title": "%container.title%",
          "icon": "media/harness-deck.svg"
        }
      ]
    },
    "views": {
      "harnessDeck": [
        {
          "type": "webview",
          "id": "harnessDeck.chatView",
          "name": "%view.chat%"
        }
      ]
    },
    "commands": [
      {
        "command": "harnessDeck.openWorkbench",
        "title": "%command.openWorkbench%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.openChat",
        "title": "%command.openChat%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.newSession",
        "title": "%command.newSession%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.interrupt",
        "title": "%command.interrupt%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.selectModel",
        "title": "%command.selectModel%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.openWebUI",
        "title": "%command.openWebUI%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.restartRuntime",
        "title": "%command.restartRuntime%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.showLogs",
        "title": "%command.showLogs%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.explainSelection",
        "title": "%command.explainSelection%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.fixSelection",
        "title": "%command.fixSelection%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.testSelection",
        "title": "%command.testSelection%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.addToChat",
        "title": "%command.addToChat%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.configureApiKey",
        "title": "%command.configureApiKey%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.renameSession",
        "title": "%command.renameSession%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.selectFolder",
        "title": "%command.selectFolder%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.selectBackend",
        "title": "%command.selectBackend%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.selectChannel",
        "title": "%command.selectChannel%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.loginAccount",
        "title": "%command.loginAccount%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.toggleRemoteBridge",
        "title": "%command.toggleRemoteBridge%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.generateRemotePairing",
        "title": "%command.generateRemotePairing%",
        "category": "Halo"
      },
      {
        "command": "harnessDeck.showRemoteDevices",
        "title": "%command.showRemoteDevices%",
        "category": "Halo"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "harnessDeck.defaultBackend": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.defaultBackend%"
        },
        "harnessDeck.dsh.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.runtime.path%"
        },
        "harnessDeck.dsh.profile": {
          "type": "string",
          "default": "web",
          "markdownDescription": "%config.runtime.profile%"
        },
        "harnessDeck.zcode.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.zcode.path%"
        },
        "harnessDeck.claude.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.claude.path%"
        },
        "harnessDeck.pi.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.pi.path%"
        },
        "harnessDeck.codex.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.codex.path%"
        },
        "harnessDeck.codebuddy.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.codebuddy.path%"
        },
        "harnessDeck.backends": {
          "type": "array",
          "scope": "machine",
          "markdownDescription": "%config.backends%",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string",
                "markdownDescription": "%config.backends.id%"
              },
              "name": {
                "type": "string",
                "markdownDescription": "%config.backends.name%"
              },
              "command": {
                "type": "string",
                "markdownDescription": "%config.backends.command%"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "%config.backends.args%"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "markdownDescription": "%config.backends.env%"
              },
              "installHint": {
                "type": "string",
                "markdownDescription": "%config.backends.installHint%"
              },
              "singleSession": {
                "type": "boolean",
                "markdownDescription": "%config.backends.singleSession%"
              }
            }
          }
        },
        "harnessDeck.context.includeActiveEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.context.includeActiveEditor%"
        },
        "harnessDeck.ui.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "default": "auto",
          "markdownDescription": "%config.ui.language%",
          "markdownEnumDescriptions": [
            "%config.ui.language.auto%",
            "%config.ui.language.zh%",
            "%config.ui.language.en%"
          ]
        },
        "harnessDeck.ui.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "markdownDescription": "%config.ui.fontSize%"
        },
        "harnessDeck.ui.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ui.fontFamily%"
        },
        "harnessDeck.ui.lineHeight": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 2.4,
          "markdownDescription": "%config.ui.lineHeight%"
        },
        "harnessDeck.ui.paragraphSpacing": {
          "type": "number",
          "default": -1,
          "minimum": -1,
          "maximum": 32,
          "markdownDescription": "%config.ui.paragraphSpacing%"
        },
        "harnessDeck.ui.contentWidth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1600,
          "markdownDescription": "%config.ui.contentWidth%"
        },
        "harnessDeck.ui.codeFontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ui.codeFontFamily%"
        },
        "harnessDeck.ui.terminalFontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 24,
          "markdownDescription": "%config.ui.terminalFontSize%"
        },
        "harnessDeck.ui.terminalLineHeight": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 2.4,
          "markdownDescription": "%config.ui.terminalLineHeight%"
        },
        "harnessDeck.backendTrace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.backendTrace%"
        },
        "harnessDeck.ui.showTurnChanges": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.ui.showTurnChanges%"
        },
        "harnessDeck.ui.theme": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ],
          "markdownEnumDescriptions": [
            "%config.ui.theme.system%",
            "%config.ui.theme.light%",
            "%config.ui.theme.dark%"
          ],
          "default": "dark",
          "markdownDescription": "%config.ui.theme%"
        },
        "harnessDeck.ui.preset": {
          "type": "string",
          "enum": [
            "default",
            "grove",
            "ocean",
            "ember",
            "iris"
          ],
          "default": "default",
          "description": "OKLCH color theme preset for Halo UI."
        },
        "harnessDeck.ui.highContrast": {
          "type": "boolean",
          "default": false,
          "description": "Increase border and text contrast in Halo UI."
        },
        "harnessDeck.browser.executablePath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Optional custom Chrome / Edge / Chromium executable path for the Halo built-in browser."
        },
        "harnessDeck.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifications.enabled%"
        },
        "harnessDeck.notifications.onlyWhenUnfocused": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifications.onlyWhenUnfocused%"
        },
        "harnessDeck.notifications.onAttention": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifications.onAttention%"
        },
        "harnessDeck.notifications.onTurnComplete": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifications.onTurnComplete%"
        },
        "harnessDeck.notifications.onUnexpectedExit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifications.onUnexpectedExit%"
        },
        "harnessDeck.notifications.onScheduledComplete": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.notifications.onScheduledComplete%"
        },
        "harnessDeck.schedules.permission": {
          "type": "string",
          "enum": [
            "danger-full-access",
            "workspace-write",
            "read-only"
          ],
          "markdownEnumDescriptions": [
            "%config.schedules.permission.full%",
            "%config.schedules.permission.workspace%",
            "%config.schedules.permission.read%"
          ],
          "default": "danger-full-access",
          "markdownDescription": "%config.schedules.permission%"
        },
        "harnessDeck.projects": {
          "type": "object",
          "scope": "application",
          "default": {},
          "markdownDescription": "%config.projects%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "copyFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "setupCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "verifyCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "harnessDeck.chatCommands": {
          "type": "array",
          "scope": "application",
          "default": [],
          "markdownDescription": "%config.chatCommands%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "prompt"
            ],
            "properties": {
              "name": {
                "type": "string",
                "markdownDescription": "%config.chatCommands.name%"
              },
              "description": {
                "type": "string",
                "markdownDescription": "%config.chatCommands.description%"
              },
              "prompt": {
                "type": "string",
                "markdownDescription": "%config.chatCommands.prompt%"
              }
            }
          }
        },
        "harnessDeck.mcpServers": {
          "type": "array",
          "scope": "machine",
          "default": [],
          "markdownDescription": "%config.mcpServers%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "transport"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "enabled": {
                "type": "boolean"
              },
              "agents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "importedFrom": {
                "type": "string"
              }
            }
          }
        },
        "harnessDeck.protocolGateway": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "markdownDescription": "%config.protocolGateway%"
        },
        "harnessDeck.acpRegistryUrl": {
          "type": "string",
          "scope": "application",
          "default": "",
          "markdownDescription": "%config.acpRegistryUrl%"
        },
        "harnessDeck.providers": {
          "type": "array",
          "scope": "application",
          "default": [],
          "markdownDescription": "%config.providers%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "presetId": {
                "type": "string"
              },
              "anthropicUrl": {
                "type": "string"
              },
              "openaiChatUrl": {
                "type": "string"
              },
              "openaiResponsesUrl": {
                "type": "string"
              },
              "convertOpenaiToAnthropic": {
                "type": "boolean"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "contextWindow": {
                      "type": "string"
                    },
                    "maxOutputTokens": {
                      "type": "string"
                    },
                    "efforts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "vision": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "defaultModel": {
                "type": "string"
              },
              "smallModel": {
                "type": "string"
              },
              "boundBackendIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "boundAgentIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "harnessDeck.accounts": {
          "type": "array",
          "scope": "machine",
          "markdownDescription": "%config.accounts%",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "backendId",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "backendId": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "isolateSessions": {
                "type": "boolean"
              },
              "region": {
                "type": "string",
                "enum": [
                  "cn",
                  "ai",
                  "internal"
                ]
              },
              "createdAt": {
                "type": "number"
              }
            }
          }
        },
        "harnessDeck.backendChannels": {
          "type": "object",
          "scope": "machine",
          "markdownDescription": "%config.backendChannels%",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "official",
                  "provider"
                ]
              },
              "accountId": {
                "type": "string"
              },
              "providerId": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "submenus": [
      {
        "id": "harnessDeck.editorContext",
        "label": "%submenu.editor%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "harnessDeck.editorContext",
          "group": "1_harnessDeck@1",
          "when": "resourceScheme == file"
        }
      ],
      "harnessDeck.editorContext": [
        {
          "command": "harnessDeck.explainSelection",
          "group": "1_ask@1"
        },
        {
          "command": "harnessDeck.fixSelection",
          "group": "1_ask@2"
        },
        {
          "command": "harnessDeck.testSelection",
          "group": "1_ask@3"
        },
        {
          "command": "harnessDeck.addToChat",
          "group": "2_context@1"
        }
      ],
      "commandPalette": [
        {
          "command": "harnessDeck.explainSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "harnessDeck.fixSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "harnessDeck.testSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "harnessDeck.addToChat",
          "when": "editorIsOpen"
        },
        {
          "command": "harnessDeck.selectFolder",
          "when": "workspaceFolderCount > 1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "tsx scripts/m0-smoke.ts",
    "package": "vsce package --no-dependencies --skip-license",
    "e2e": "tsx scripts/ui-e2e.ts",
    "vscode-e2e": "tsx scripts/vscode-e2e.ts",
    "acp-e2e": "tsx scripts/acp-e2e.ts"
  },
  "dependencies": {
    "@harness-deck/shared": "workspace:*",
    "diff": "^8.0.4",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/vscode": "~1.106.0",
    "@types/ws": "^8.18.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0"
  }
}
